---
layout: null
---
[{% for post in site.posts %}{% unless forloop.first %},{% endunless %}{"t":"post","title":{{ post.title | jsonify }},"url":"{{ site.baseurl }}{{ post.url }}","date":"{{ post.date | date: '%Y-%m-%d' }}","tags":{{ post.tags | jsonify }},"body":{{ post.content | strip_html | strip_newlines | truncate: 600 | jsonify }}}{% endfor %}{% for page in site.pages %}{% if page.layout == 'mhenry-chapter' %},{"t":"mhenry","title":{{ page.book_name | append: ' 第' | append: page.chapter | append: '章' | jsonify }},"book":{{ page.book_name | jsonify }},"url":"{{ site.baseurl }}{{ page.url }}","body":{{ page.content | strip_html | strip_newlines | truncate: 300 | prepend: ' ' | prepend: page.chapter | prepend: '第' | prepend: ' ' | prepend: page.book_name | prepend: '马太亨利圣经注释 ' | jsonify }}}{% endif %}{% if page.layout == 'calvin-chapter' %},{"t":"calvin","title":{{ page.book_name | append: ' 第' | append: page.chapter | append: '章' | jsonify }},"book":{{ page.book_name | jsonify }},"url":"{{ site.baseurl }}{{ page.url }}","body":{{ page.content | strip_html | strip_newlines | truncate: 300 | prepend: ' ' | prepend: page.chapter | prepend: '第' | prepend: ' ' | prepend: page.book_name | prepend: '加尔文圣经注释 ' | jsonify }}}{% endif %}{% if page.layout == 'calvin-en' %},{"t":"calvin","title":{% if page.chapter %}{{ page.book_name | append: ' 第' | append: page.chapter | append: '章' | jsonify }}{% else %}{{ page.book_name | append: ' ' | append: page.title | jsonify }}{% endif %},"book":{{ page.book_name | jsonify }},"url":"{{ site.baseurl }}{{ page.url }}","body":{{ page.content | strip_html | strip_newlines | truncate: 300 | prepend: ' ' | prepend: page.chapter | prepend: '第' | prepend: ' ' | prepend: page.book_name | prepend: '加尔文圣经注释 ' | jsonify }}}{% endif %}{% if page.layout == 'reading-chapter' %},{"t":"reading","title":{{ page.section_title | default: page.title | default: '' | jsonify }},"book":{{ page.book_title | default: '' | jsonify }},"author":{{ page.author_name | default: '' | jsonify }},"url":"{{ site.baseurl }}{{ page.url }}","body":{{ page.content | strip_html | strip_newlines | truncate: 400 | prepend: ' ' | prepend: page.author_name | prepend: ' ' | prepend: page.book_title | prepend: ' ' | prepend: page.section_title | jsonify }}}{% endif %}{% endfor %}]
