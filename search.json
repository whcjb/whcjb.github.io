---
layout: null
---
[{% for post in site.posts %}{% unless forloop.first %},{% endunless %}{"t":"post","title":{{ post.title | jsonify }},"url":"{{ site.baseurl }}{{ post.url }}","date":"{{ post.date | date: '%Y-%m-%d' }}","tags":{{ post.tags | jsonify }},"body":{{ post.content | strip_html | strip_newlines | truncate: 600 | jsonify }}}{% endfor %}{% for page in site.pages %}{% if page.layout == 'mhenry-chapter' %},{"t":"mhenry","title":{{ page.book_name | append: '第' | append: page.chapter | append: '章' | jsonify }},"book":{{ page.book_name | jsonify }},"url":"{{ site.baseurl }}{{ page.url }}","body":{{ page.book_name | append: ' 马太亨利圣经注释 第' | append: page.chapter | append: '章' | jsonify }}}{% endif %}{% if page.layout == 'calvin-chapter' %},{"t":"calvin","title":{{ page.book_name | append: '第' | append: page.chapter | append: '章' | jsonify }},"book":{{ page.book_name | jsonify }},"url":"{{ site.baseurl }}{{ page.url }}","body":{{ page.book_name | append: ' 加尔文圣经注释 第' | append: page.chapter | append: '章' | jsonify }}}{% endif %}{% if page.layout == 'reading-chapter' %},{"t":"reading","title":{{ page.title | default: '' | jsonify }},"url":"{{ site.baseurl }}{{ page.url }}","body":{{ page.title | default: '' | jsonify }}}{% endif %}{% endfor %}]
